{
  "name": "chat.app.privacysafe.io",
  "version": "0.12.40",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:deno": "bash bundle-deno-code.sh",
    "build:deno:dev": "bash bundle-deno-code.sh --dev",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "bench:db": "deno run -A ci/bench-db-writes.ts",
    "test:db-migration": "deno test -A --no-check ci/db-migration.test.ts",
    "test:backup-restore": "deno test -A --no-check ci/backup-restore.test.ts",
    "test:db-writer": "deno test -A --no-check ci/db-writer-timeout.test.ts",
    "test:i18n-keys": "deno test -A --no-check ci/i18n-keys.test.ts",
    "test:blocked-inbox-retention": "deno test -A --no-check ci/blocked-inbox-retention.test.ts",
    "test:invitation-sync": "deno test -A --no-check ci/invitation-sync.test.ts",
    "test:chats-resync": "deno test -A --no-check ci/chats-resync.test.ts",
    "test:auto-backup": "deno test -A --no-check ci/auto-backup.test.ts",
    "run:mac:1": "bash ./run-test-mac.sh /Applications/privacysafe.app 2>&1 | tee live-user1-A.log",
    "run:mac:2": "bash ./run-test-mac1.sh /Applications/privacysafe.app 2>&1 | tee live-user1-B.log",
    "run:mac:3": "bash ./run-test-mac2.sh /Applications/privacysafe.app 2>&1 | tee live-user2.log",
    "run:mac:4": "bash ./run-test-mac3.sh /Applications/privacysafe.app 2>&1 | tee live-user3.log",
    "tests:build": "bash tests-app/compile-and-build.sh",
    "tests:build-all": "pnpm build && pnpm tests:build",
    "tests:run-on": "bash tests-app/run-tests-on.sh",
    "serve": "vite preview",
    "stylelint:main": "stylelint --config .stylelint.config.cjs 'src-main/**/*.{vue,scss,css}'",
    "stylelint:main:fix": "stylelint --config .stylelint.config.cjs --fix 'src-main/**/*.{vue,scss,css}'",
    "stylelint:video": "stylelint --config .stylelint.config.cjs 'src-video/**/*.{vue,scss,css}'",
    "stylelint:video:fix": "stylelint --config .stylelint.config.cjs --fix 'src-video/**/*.{vue,scss,css}'",
    "stylelint": "pnpm stylelint:main && pnpm stylelint:video",
    "linter:main": "eslint -c eslint.config.js --ext .vue,.ts, src-main",
    "linter:main:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src-main",
    "linter:video": "eslint -c eslint.config.js --ext .vue,.ts, src-video",
    "linter:video:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src-video",
    "linter": "pnpm linter:main && pnpm linter:video",
    "lint": "pnpm linter && pnpm stylelint"
  },
  "dependencies": {
    "@dbushell/hyperless": "0.35.0",
    "@v1nt1248/3nclient-lib": "0.4.16",
    "@vueuse/core": "15.0.0",
    "dayjs": "1.11.23",
    "fflate": "0.8.3",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/runtime-core": "3.5.45",
    "@vue/test-utils": "2.5.1",
    "@vuedx/typescript-plugin-vue": "0.7.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "41.0.0",
    "stylelint-scss": "7.4.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.6.0"
}
