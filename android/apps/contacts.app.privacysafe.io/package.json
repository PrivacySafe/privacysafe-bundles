{
  "name": "contacts.app.privacysafe.io",
  "version": "0.8.52",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:deno": "bash bundle-deno-code.sh",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "tests:build": "bash tests/app/compile-and-build.sh",
    "tests:build-all": "pnpm run build && pnpm run tests:build",
    "tests:run-on": "bash tests/app/run-tests-on.sh",
    "test": "vitest run",
    "test:all": "bash tests/run-all-tests.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --reporter=html",
    "test:report:view": "vite preview --outDir tests/report",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src tests/unit",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src tests/unit",
    "lint": "pnpm linter && pnpm stylelint"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.4.15",
    "beautiful-qr-code": "1.0.11",
    "driver.js": "1.10.2",
    "fflate": "0.8.3",
    "lodash": "4.18.1",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.2.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/ui": "4.1.12",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postcss-html": "1.8.1",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.6.0"
}
