{
  "name": "files.app.privacysafe.io",
  "version": "0.8.16",
  "description": "Apps Storage",
  "author": "3NSoft, Inc.",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:deno": "bash bundle-deno-code.sh",
    "check:deno": "deno check src_deno/index.ts",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs '{src,src-file-picker}/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix '{src,src-file-picker}/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js src src-file-picker src_deno shared tests",
    "linter:fix": "eslint -c eslint.config.js --fix src src-file-picker src_deno shared tests",
    "lint": "pnpm run linter && pnpm run stylelint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.4.15",
    "dayjs": "1.11.23",
    "file-type": "22.2.0",
    "hash-wasm": "4.12.0",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.4.299",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.6.0"
}
