{
  "name": "inbox.app.privacysafe.io",
  "version": "0.3.54",
  "description": "Inbox App",
  "author": "3NSoft, Inc.",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build:deno": "bash bundle-deno-code.sh",
    "build:deno:dev": "bash bundle-deno-code.sh --dev",
    "build": "vue-tsc --noEmit && vite build && pnpm run build:deno",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss}'",
    "linter": "eslint -c eslint.config.js --ext .js,.vue,.ts src src-deno shared tests/unit",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .js,.vue,.ts src src-deno shared tests/unit",
    "lint": "pnpm run linter && pnpm run stylelint",
    "lint:fix": "pnpm run linter:fix && pnpm run stylelint:fix",
    "tests:build": "bash tests/app/compile-and-build.sh",
    "tests:build-all": "pnpm run build && pnpm run tests:build",
    "tests:run-on": "bash tests/app/run-tests-on.sh",
    "test": "vitest run",
    "test:all": "bash tests/run-all-tests.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --reporter=html",
    "test:report:view": "vite preview --outDir tests/report"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.2",
    "@v1nt1248/3nclient-lib": "0.4.16",
    "@vueuse/core": "15.0.0",
    "dayjs": "1.11.23",
    "fflate": "0.8.3",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "3.0.4",
    "sanitize-html": "2.18.1",
    "squire-rte": "2.4.10",
    "vue": "3.5.45",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "7.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/ui": "5.1.0",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-scss": "7.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.6.0"
}
