{
  "name": "treasure.app.privacysafe.io",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-assets": "node scripts/copy-assets.js",
    "dev": "pnpm copy-assets && vite",
    "build:deno": "bash bundle-deno-code.sh",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm copy-assets && pnpm build:gui && pnpm build:deno",
    "serve": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src tests/unit",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src tests/unit",
    "lint": "pnpm linter && pnpm stylelint"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.4.16",
    "@vueuse/core": "15.0.0",
    "dayjs": "1.11.23",
    "fflate": "0.8.3",
    "lodash": "4.18.1",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-advanced-cropper": "2.8.9",
    "vue-ccard": "2.0.0",
    "vue-i18n": "11.4.18",
    "vue-router": "5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss-html": "1.8.1",
    "prettier": "3.10.0",
    "sass": "1.108.2",
    "stylelint": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "41.0.0",
    "stylelint-scss": "7.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.6.0"
}
