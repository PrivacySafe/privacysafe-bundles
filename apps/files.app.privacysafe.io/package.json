  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "clean:coverage": "rimraf coverage",
    "dev": "vite",
    "build:deno": "bash bundle-deno-code.sh",
    "build:gui": "vue-tsc --noEmit && vite build",
    "build": "pnpm lint && pnpm build:gui && pnpm build:deno",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss,css}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint",
    "test": "pnpm run clean:coverage && jest",
    "test:watch": "pnpm run clean:coverage && jest --watch"
  },
  "dependencies": {
    "@v1nt1248/3nclient-lib": "0.4.3",
    "dayjs": "1.11.23",
    "file-type": "22.1.1",
    "hash-wasm": "4.12.0",
    "lodash": "4.18.1",
    "pdfjs-dist": "6.3.289",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-i18n": "11.4.13",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/jasmine": "6.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  },
  "packageManager": "pnpm@12.6.0"
}
