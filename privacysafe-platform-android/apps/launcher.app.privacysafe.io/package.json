{
  "name": "launcher.app.privacysafe.io",
  "version": "0.11.44",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:dist": "rm -rf app/",
    "copy:settings": "mkdir -p app/constants && cp -r src/common/constants/settings.json app/constants/settings.json",
    "build": "pnpm run clean:dist && vue-tsc --noEmit && vite build && pnpm run copy:settings",
    "tests:build": "bash tests-app/compile-and-build.sh",
    "build-all": "pnpm run build && pnpm run tests:build",
    "tests:run-on": "bash tests-app/run-tests-on.sh",
    "serve": "vite preview",
    "stylelint": "stylelint --config .stylelint.config.cjs 'src/**/*.{vue,scss}'",
    "stylelint:fix": "stylelint --config .stylelint.config.cjs --fix 'src/**/*.{vue,scss}'",
    "linter": "eslint -c eslint.config.js --ext .vue,.ts, src",
    "linter:fix": "eslint -c eslint.config.js --fix --ext .vue,.ts, src",
    "lint": "pnpm run linter && pnpm run stylelint"
  },
  "dependencies": {
    "@terrastruct/d2": "0.1.33",
    "@types/semver": "7.8.0",
    "@v1nt1248/3nclient-lib": "0.4.0",
    "@vueuse/core": "14.4.0",
    "lodash": "4.18.1",
    "pinia": "3.0.4",
    "semver": "7.8.5",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "5.1.15",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.6",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/devtools": "8.2.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "postcss-html": "1.8.1",
    "prettier": "3.9.8",
    "sass": "1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.18.0"
}
