    "lodash": "4.18.1",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-advanced-cropper": "2.8.9",
    "vue-ccard": "2.0.0",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
